.dashboard-layout {
  min-height: 100vh;
  background: var(--color-aqua-haze);
  color: var(--color-ebony);
  font-family: Inter, "Segoe UI", Arial, sans-serif;

  &__content {
    min-height: 100vh;
    margin-inline-start: 240px;
    display: flex;
    flex-direction: column;
    background: #f8fafb;
  }

  &__body {
    flex: 1;
    min-height: 0;
  }
}

.dashboard-sidebar {
  position: fixed;
  z-index: 20;
  inset-block: 0;
  inset-inline-start: 0;
  width: 240px;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-white);
  border-inline-end: 1px solid var(--color-border);
  color: var(--color-pale-sky);

  &__brand {
    min-height: 69px;
    padding: 16px 20px 17px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--color-border);

    img {
      width: 36px;
      height: 36px;
      flex: 0 0 auto;
      object-fit: contain;
    }

    div {
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    strong {
      overflow: hidden;
      color: var(--color-ebony);
      font-size: 12px;
      line-height: 15px;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    span {
      color: var(--color-text-muted-light);
      font-size: 9.5px;
      line-height: 15px;
    }
  }

  &__navigation {
    flex: 1;
    min-height: 0;
    padding: 16px 12px;
    overflow-y: auto;

    nav {
      display: grid;
      gap: 2px;
    }
  }

  &__menu-label {
    margin: 0 8px 8px;
    color: var(--color-text-muted-light);
    font-size: 10px;
    line-height: 15px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  &__link {
    min-height: 40px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 8px;
    color: #4b5563;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;

    &:hover {
      background: var(--color-muted-surface);
      color: var(--color-ebony);
    }

    &:focus-visible {
      outline: 3px solid rgba(10, 135, 130, 0.24);
      outline-offset: 2px;
    }

    &--active,
    &--active:hover {
      background: var(--color-blue-chill);
      color: #ffffff;
    }

    svg {
      flex: 0 0 auto;
    }
  }

  &__account {
    min-height: 73px;
    padding: 21px 20px 20px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22px;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--color-border);
  }

  &__profile-link {
    min-width: 0;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;

    &:focus-visible {
      outline: 3px solid rgba(10, 135, 130, 0.24);
      outline-offset: 3px;
    }
  }

  &__avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #f1eafa;
    color: var(--color-eminence);
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    text-decoration: none;
    overflow: hidden;

    img,
    &-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  &__account-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;

    strong,
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--color-ebony);
      font-size: 11.5px;
      line-height: 16px;
      font-weight: 700;
    }

    span {
      color: var(--color-text-muted-light);
      font-size: 9.5px;
      line-height: 15px;
    }
  }

  &__logout {
    width: 22px;
    height: 22px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted-light);
    cursor: pointer;

    &:hover {
      background: var(--color-muted-surface);
      color: var(--color-ebony);
    }

    &:focus-visible {
      outline: 3px solid rgba(10, 135, 130, 0.24);
      outline-offset: 2px;
    }
  }
}

.dashboard-header {
  min-height: 52px;
  padding: 12px 24px 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  background: var(--color-bg-white);
  border-bottom: 1px solid var(--color-border);

  &__breadcrumb,
  &__actions {
    display: flex;
    align-items: center;
  }

  &__breadcrumb {
    min-width: 0;
    gap: 6px;
    color: var(--color-text-muted-light);
    font-size: 12px;
    line-height: 20px;

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--color-blue-chill);
      }
    }

    span {
      overflow: hidden;
      color: var(--color-ebony);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    svg {
      flex: 0 0 auto;
    }
  }

  &__actions {
    gap: 12px;
  }

  &__notifications {
    position: relative;
    width: 28px;
    height: 28px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #9ca3af;
    cursor: pointer;

    &:hover {
      background: var(--color-muted-surface);
      color: var(--color-ebony);
    }

    &:focus-visible {
      outline: 3px solid rgba(10, 135, 130, 0.24);
      outline-offset: 2px;
    }

    span {
      position: absolute;
      inset-block-start: -2px;
      inset-inline-end: -2px;
      min-width: 16px;
      height: 16px;
      padding-inline: 4px;
      display: grid;
      place-items: center;
      border: 2px solid var(--color-bg-white);
      border-radius: 999px;
      background: var(--color-cerise);
      color: #ffffff;
      font-size: 8px;
      line-height: 12px;
      font-weight: 700;
    }
  }

  &__avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #f1eafa;
    color: var(--color-eminence);
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    overflow: hidden;

    img,
    &-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }
}

[dir="rtl"] {
  .dashboard-sidebar {
    &__logout svg {
      transform: scaleX(-1);
    }
  }

  .dashboard-header {
    &__breadcrumb > svg {
      transform: scaleX(-1);
    }
  }
}

@media (max-width: 760px) {
  .dashboard-layout {
    &__content {
      display: none;
    }
  }

  .dashboard-sidebar {
    width: 100%;
    border-inline-end: 0;

    &__brand {
      padding-inline: 24px;
    }

    &__navigation {
      padding-inline: 24px;
    }

    &__account {
      padding-inline: 32px;
    }
  }
}
